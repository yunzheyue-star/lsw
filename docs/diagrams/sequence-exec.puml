@startuml
title lsw <program> 时序（P8）
actor User
participant "lsw" as CLI
participant "lswd" as Daemon
participant "ssh" as SSH
participant "Windows OpenSSH" as WinSSH
participant "PowerShell / cmd" as PS

User -> CLI : lsw test.bat arg1 arg2
CLI -> CLI : current_path()
CLI -> Daemon : exec { argv, cwd }
Daemon -> Daemon : resolve_target(argv[0], cwd, $HOME)
alt 程序不在 $HOME 下
  Daemon -> Daemon : 复制到 ~/.lsw/tmp/<hash>/
end
alt GUI exe（PE Subsystem==2）
  Daemon --> CLI : error PROGRAM_FAILED（退出码 7）
else 可执行
  Daemon -> Daemon : build Exec EncodedCommand\n(net use Z: + Copy-Item 到 %TEMP% + & $program)
  Daemon -> SSH : ssh -p 2222 -o BatchMode=yes ...\n-- powershell.exe -NoProfile -NonInteractive -EncodedCommand
  SSH -> WinSSH : 连接 127.0.0.1:2222
  WinSSH -> PS : 复制到 %TEMP%\lsw-exec-* 并 Unblock\n执行 test.bat / .exe
  PS --> SSH : stdout / stderr / exit code
  SSH --> Daemon : stdout / stderr / exit code
  Daemon --> CLI : { stdout, stderr, exit_code }
  CLI --> User : 透传 stdout/stderr；退出码透传（0–255）
end
@enduml
